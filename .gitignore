# Виртуальное окружение Python
.venv/
__pycache__/
*.pyc

# Секреты приложения
.env
.env.dev
.env.prod

# Локальные файлы конфигурации линтеров
alembic.ini.bak
docker-compose.dev.yml.bak

# Служебные файлы Terraform (КРИТИЧЕСКИ ВАЖНО)
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfvars
# Генерируется автоматически из terraform output (terraform/generate_inventory.sh)
# и содержит реальные публичные IP — не коммитим.
ansible/inventory/hosts.ini
ansible/group_vars/vault.yml
reports/
.pytest_cache/
htmlcov/
.coverage
