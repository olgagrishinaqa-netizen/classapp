FLASK_CONFIG=config.ProdConfig
REPO_OWNER=your-github-org-or-user
IMAGE_TAG=main-<commit-sha>
SECRET_KEY=replace-me
DB_PASSWORD=replace-me
GRAFANA_ADMIN_PASSWORD=replace-me
PROMETHEUS_IMAGE=prom/prometheus:v2.48.0
GRAFANA_IMAGE=grafana/grafana:9.5.3
DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname
