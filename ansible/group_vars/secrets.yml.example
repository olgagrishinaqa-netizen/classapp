---
# Секреты Ansible. `make configure` создаёт group_vars/secrets.yml сам (случайный токен, права 600);
# файл в .gitignore и в образ не попадает. Вручную: скопируйте этот файл в secrets.yml.
# Файл хранится открытым текстом: защита — права 600 и то, что он не коммитится. Для общего репозитория
# зашифруйте его: ansible-vault encrypt group_vars/secrets.yml, запускайте с --ask-vault-pass.
k3s_token: "CHANGE_ME"
